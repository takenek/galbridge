{
    "name": "takenek/galbridge",
    "type": "roundcube-plugin",
    "description": "GAL Bridge - read-only Global Address List for Roundcube 1.7.7 from the iRedMail 1.8 SQL (vmail) database: domain and global address books, groups and mailing lists, MySQL/MariaDB and PostgreSQL.",
    "keywords": ["roundcube", "plugin", "addressbook", "gal", "global-address-list", "iredmail", "vmail"],
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/takenek/galbridge",
    "authors": [
        {
            "name": "TaKeN.PL Usługi Informatyczne Marek Królikowski",
            "homepage": "https://github.com/takenek",
            "role": "Developer and Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/takenek/galbridge/issues",
        "source": "https://github.com/takenek/galbridge",
        "security": "https://github.com/takenek/galbridge/security/policy"
    },
    "require": {
        "php": ">=8.1 <8.6",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "roundcube/plugin-installer": "~0.3.5"
    },
    "suggest": {
        "ext-pdo_mysql": "iRedMail MySQL/MariaDB edition (vmail database)",
        "ext-pdo_pgsql": "iRedMail PostgreSQL edition (vmail database)",
        "ext-intl": "Internationalised domain names (IDN) and Unicode normalisation of directory data"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^13.4.4"
    },
    "autoload": {
        "psr-4": {
            "GalBridge\\": "lib/GalBridge/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GalBridge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "roundcube": {
            "min-version": "1.7.7",
            "max-version": "1.7.999"
        }
    },
    "config": {
        "allow-plugins": {
            "roundcube/plugin-installer": true
        }
    }
}
