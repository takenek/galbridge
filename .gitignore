# local configuration (contains the vmail database password) - and the copies an editor, a
# package manager or an administrator leaves next to it (the template stays tracked)
/config.inc.php
/config.inc.php.*
!/config.inc.php.dist
/config.inc.php~
/galbridge.inc.php
/galbridge.inc.php.*
/config/
# output of "bin/galbridge.sh grants" saved in the checkout (the SQL/ templates stay tracked; the
# DSN line with the role password goes to standard error, but keep such files out anyway)
/*.sql
.env.*
*.bak
*.orig
*~
# tooling
/vendor/
/composer.lock
/.phpunit.cache/
/.phpunit.result.cache
/.php-cs-fixer.cache
/tmp/
/build/
/tests/e2e/run/
/tests/e2e/*.log
# NOTE: tests/fixtures/vmail/ IS committed on purpose: TEST-ONLY data (see tests/fixtures/vmail/README.txt)
__pycache__/
# editors / local tooling
.claude/
.idea/
.vscode/
.DS_Store
*.swp
.env
/phpstan.neon
# Security audit working documents and delivered artefacts: they describe findings in detail and
# stay OUT of the repository (and so out of a "git clone" installation); what was fixed is
# recorded in CHANGELOG.md and SECURITY.md. Keep them elsewhere.
/FINAL_SECURITY_REPORT.md
/STAGE_*.md
/DOSTARCZONE/
